diff --git a/libs/components/src/tw-theme.css b/libs/components/src/tw-theme.css
index a212ada..ecff293 100644
--- a/libs/components/src/tw-theme.css
+++ b/libs/components/src/tw-theme.css
@@ -884,3 +884,120 @@
     display: none;
   }
 }
+
+/* ========================================
+ * KOUNT — the Kount look, direction B · Navy header (apps/kount-extension/docs/design/restyle-mockups/board.html;
+ * plan-platform-kount-protect-sign-in-lock-and-look Decision 9). Kount's teal in place of the brand blue, Protect's
+ * navy on the popup's header band, small capital section labels and an outlined Fill. Colours, sizes, borders and
+ * text styles only: no element is added, removed or moved. Protect's palette: apps/kount-protect/src/render/shell.ts.
+ * ======================================== */
+:root {
+  /* The brand scale, step for step as light as the blue it replaces (so every pairing keeps its contrast); 700 and
+     800 are Protect's teal and its hover, 400 Protect's dark-mode teal. */
+  --color-brand-050: #e8faf7;
+  --color-brand-100: #c8f1ea;
+  --color-brand-200: #9fe5da;
+  --color-brand-300: #5fd2c3;
+  --color-brand-400: #2dd4bf;
+  --color-brand-500: #149c8f;
+  --color-brand-600: #0e8378;
+  --color-brand-700: #0f766e;
+  --color-brand-700-rgb: 15, 118, 110;
+  --color-brand-800: #0b5d56;
+  --color-brand-900: #0a4642;
+  --color-brand-950: #082f2c;
+  --color-brand-800-rgb: 11, 93, 86;
+  --color-brand-950-rgb: 8, 47, 44;
+
+  /* The legacy primary (older components). */
+  --color-primary-100: 204 239 233;
+  --color-primary-300: 95 210 195;
+  --color-primary-600: 15 118 110;
+  --color-primary-700: 11 93 86;
+  --color-hover-default: rgb(15 118 110 / 0.1);
+
+  --kount-navy: #1b2845;
+}
+
+.theme_dark {
+  --color-primary-100: 19 78 74;
+  --color-primary-300: 15 118 110;
+  --color-primary-600: 45 212 191;
+  --color-primary-700: 153 246 228;
+  --color-hover-default: rgb(45 212 191 / 0.1);
+
+  --kount-navy: #131c33;
+}
+
+/* The navy band: the popup's header (both its bars). Text and icons on it read light — the tokens its children paint
+   with are set again inside it. */
+popup-header > header,
+popup-header > header [data-testid="title-bar"],
+popup-header > header [data-testid="app-bar"] {
+  background-color: var(--kount-navy) !important;
+  border-color: transparent !important;
+}
+popup-header > header {
+  /* The wordmark ("Kount Protect" beside the mark) paints with the legacy marketing-logo colour: white on the band in
+     both themes (light's blue read 1.2 : 1 on the navy — s1e4's captures). */
+  --color-marketing-logo: 255 255 255;
+  --color-text-main: 255 255 255;
+  --color-text-muted: 198 207 220;
+  --color-fg-heading: #ffffff;
+  --color-fg-body: #e8edf5;
+  --color-fg-body-subtle: #c6cfdc;
+  --color-fg-nav: #ffffff;
+  --color-bg-hover: rgb(255 255 255 / 0.12);
+  --color-hover-default: rgb(255 255 255 / 0.12);
+  --color-border-focus: #ffffff;
+  /* Plain text projected into the band (the item count beside the title) inherits white, not the body's dark text
+     (round 12 PR-MED-066); a control with its own colour pair keeps it. */
+  color: rgb(var(--color-text-main));
+}
+popup-header > header button[bitIconButton] {
+  /* The header's ghost icon buttons (Back, Pop out) take the brand foreground on hover and keyboard focus: a light teal
+     on the band — ~10 : 1 on the navy, ~7 : 1 on the hover's lightened navy (round 11 PR-MED-062; teal #0f766e read
+     ~1.8 : 1 there). Set on those buttons only, so a chip in the header (Archived) keeps its own pale-surface pair
+     (round 12 PR-REG-001). */
+  --color-fg-brand: #5eead4;
+  --color-fg-brand-strong: #99f6e4;
+}
+
+/* Denser rows, joined into one card with dividers — upstream's own compact density (its `bit-compact:` rules), as sizes
+   and borders only. */
+bit-item [bit-item-content],
+bit-item bit-item-content {
+  padding-block: 0.25rem !important;
+}
+bit-item {
+  margin-bottom: 0 !important;
+  border-radius: 0 !important;
+}
+bit-item:first-of-type {
+  border-top-left-radius: 0.5rem !important;
+  border-top-right-radius: 0.5rem !important;
+}
+bit-item:last-of-type {
+  border-bottom-left-radius: 0.5rem !important;
+  border-bottom-right-radius: 0.5rem !important;
+}
+bit-item + bit-item {
+  border-top-width: 0 !important;
+}
+
+/* Small capital section labels. */
+bit-section-header h2 {
+  text-transform: uppercase;
+  letter-spacing: 0.07em;
+  font-size: 0.75rem !important;
+  font-weight: 650 !important;
+}
+
+/* An outlined Fill on a list row — the list layout's (in a `bit-item-action`) and the table layout's (in a `bit-cell`,
+   behind upstream's VFO1 flag, whose own `tw-border-0` this overrides; round 13 PR-LOW-014). */
+bit-item-action > button.tw-text-primary-600,
+bit-cell button.tw-text-primary-600[bitTypography] {
+  border: 1px solid rgb(var(--color-primary-600)) !important;
+  border-radius: 6px;
+  padding-block: 0.125rem;
+}
